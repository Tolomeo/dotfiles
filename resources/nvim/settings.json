{
  "config": {
    "terminal.jobs": [
      {
        "command": "lazygit"
      },
      {
        "command": "htop"
      },
      {
        "command": "node"
      },
      {
        "command": "glow"
      },
      {
        "keymap": "<leader>e",
        "command": "lf"
      }
    ],
    "workspace.root": [
      ".git",
      ".cfg"
    ],
    "macro": {
      "escapeCharacters": [
        "\"",
        "'"
      ],
      "saved": {
        "NEW": "ciwciao\u001b"
      }
    },
    "language": {
      "javascript,typescript,typescriptreact": {
        "format": [
          "prettier"
        ],
        "server": [
          "ts_ls",
          "eslint"
        ]
      },
      "html": {
        "format": [
          "prettier"
        ],
        "server": [
          "html",
          "emmet_ls"
        ]
      },
      "sh": {
        "format": [
          "shfmt"
        ],
        "server": [
          "bashls"
        ]
      },
      "haxe": {
        "format": [
          "haxe_language_server"
        ],
        "server": [
          {
            "name": "haxe_language_server",
            "install": false
          }
        ],
        "filetype": {
          "haxe": [
            "*.hx"
          ]
        }
      },
      "yaml": {
        "format": [
          "prettier"
        ],
        "server": [
          {
            "settings": {
              "schemas": {
                "https://json.schemastore.org/github-workflow.json": "/.github/workflows/*"
              }
            },
            "name": "yamlls",
            "capabilities": {
              "textDocument": {
                "foldingRange": {
                  "dynamicRegistration": false,
                  "lineFoldingOnly": true
                }
              }
            }
          }
        ]
      },
      "lua": {
        "format": [
          "stylua"
        ],
        "server": [
          "lua_ls"
        ]
      },
      "go": {
        "format": [
          "gopls"
        ],
        "server": [
          "gopls"
        ]
      },
      "dockerfile": {
        "server": [
          "dockerls"
        ]
      },
      "css,scss": {
        "format": [
          "prettier"
        ],
        "server": [
          {
            "settings": {
              "css": {
                "lint": {
                  "unknownAtRules": "ignore"
                },
                "validate": true
              }
            },
            "name": "cssls"
          },
          {
            "name": "tailwindcss"
          }
        ]
      },
      "json": {
        "format": [
          "prettier"
        ],
        "server": [
          {
            "settings": {
              "json": {
                "schemas": [
                  {
                    "name": "Sumneko Lua Settings",
                    "url": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
                    "fileMatch": [
                      ".luarc.json",
                      ".luarc.jsonc"
                    ]
                  },
                  {
                    "description": "Node project's package file",
                    "fileMatch": [
                      "package.json"
                    ],
                    "url": "https://json.schemastore.org/package.json"
                  },
                  {
                    "description": "TypeScript compiler configuration file",
                    "fileMatch": [
                      "tsconfig.json",
                      "tsconfig.*.json"
                    ],
                    "url": "http://json.schemastore.org/tsconfig"
                  },
                  {
                    "description": "Lerna config",
                    "fileMatch": [
                      "lerna.json"
                    ],
                    "url": "http://json.schemastore.org/lerna"
                  },
                  {
                    "description": "Babel configuration",
                    "fileMatch": [
                      ".babelrc.json",
                      ".babelrc",
                      "babel.config.json"
                    ],
                    "url": "http://json.schemastore.org/lerna"
                  },
                  {
                    "description": "ESLint config",
                    "fileMatch": [
                      ".eslintrc.json",
                      ".eslintrc"
                    ],
                    "url": "http://json.schemastore.org/eslintrc"
                  },
                  {
                    "description": "Prettier config",
                    "fileMatch": [
                      ".prettierrc",
                      ".prettierrc.json",
                      "prettier.config.json"
                    ],
                    "url": "http://json.schemastore.org/prettierrc"
                  }
                ],
                "validate": {
                  "enable": true
                }
              }
            },
            "name": "jsonls"
          }
        ]
      },
      "markdown": {
        "format": [
          "prettier"
        ]
      }
    },
    "theme.colorscheme": "everforest"
  }
}