{
  "config": {
    "theme.colorscheme": "everforest",
    "workspace.root": [
      ".git",
      ".cfg"
    ],
    "terminal.jobs": [
      {
        "command": "lazygit"
      },
      {
        "command": "htop"
      },
      {
        "command": "node"
      },
      {
        "command": "glow"
      },
      {
        "command": "lf",
        "keymap": "<leader>e"
      }
    ],
    "language": {
      "lua": {
        "server": [
          "lua_ls"
        ],
        "format": [
          "stylua"
        ]
      },
      "markdown": {
        "format": [
          "prettier"
        ]
      },
      "css,scss": {
        "server": [
          {
            "name": "cssls",
            "settings": {
              "css": {
                "lint": {
                  "unknownAtRules": "ignore"
                },
                "validate": true
              }
            }
          },
          {
            "name": "tailwindcss"
          }
        ],
        "format": [
          "prettier"
        ]
      },
      "json": {
        "server": [
          {
            "name": "jsonls",
            "settings": {
              "json": {
                "validate": {
                  "enable": true
                },
                "schemas": [
                  {
                    "url": "https: //raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
                    "fileMatch": [
                      ".luarc.json",
                      ".luarc.jsonc"
                    ],
                    "name": "Sumneko Lua Settings"
                  },
                  {
                    "url": "https: //json.schemastore.org/package.json",
                    "fileMatch": [
                      "package.json"
                    ],
                    "description": "Node project's package file"
                  },
                  {
                    "url": "http: //json.schemastore.org/tsconfig",
                    "fileMatch": [
                      "tsconfig.json",
                      "tsconfig.*.json"
                    ],
                    "description": "TypeScript compiler configuration file"
                  },
                  {
                    "url": "http: //json.schemastore.org/lerna",
                    "fileMatch": [
                      "lerna.json"
                    ],
                    "description": "Lerna config"
                  },
                  {
                    "url": "http: //json.schemastore.org/lerna",
                    "fileMatch": [
                      ".babelrc.json",
                      ".babelrc",
                      "babel.config.json"
                    ],
                    "description": "Babel configuration"
                  },
                  {
                    "url": "http: //json.schemastore.org/eslintrc",
                    "fileMatch": [
                      ".eslintrc.json",
                      ".eslintrc"
                    ],
                    "description": "ESLint config"
                  },
                  {
                    "url": "http: //json.schemastore.org/prettierrc",
                    "fileMatch": [
                      ".prettierrc",
                      ".prettierrc.json",
                      "prettier.config.json"
                    ],
                    "description": "Prettier config"
                  }
                ]
              }
            }
          }
        ],
        "format": [
          "prettier"
        ]
      },
      "haxe": {
        "filetype": {
          "haxe": [
            "*.hx"
          ]
        },
        "server": [
          {
            "name": "haxe_language_server",
            "install": false
          }
        ],
        "format": [
          "haxe-formatter"
        ]
      },
      "go": {
        "server": [
          "gopls"
        ],
        "format": [
          "gopls"
        ]
      },
      "yaml": {
        "server": [
          {
            "name": "yamlls",
            "capabilities": {
              "textDocument": {
                "foldingRange": {
                  "dynamicRegistration": false,
                  "lineFoldingOnly": true
                }
              }
            },
            "settings": {
              "schemas": {
                "https: //json.schemastore.org/github-workflow.json": "/.github/workflows/*"
              }
            }
          }
        ],
        "format": [
          "prettier"
        ]
      },
      "html": {
        "server": [
          "html",
          "emmet_ls"
        ],
        "format": [
          "prettier"
        ]
      },
      "javascript,typescript,typescriptreact": {
        "server": [
          "ts_ls",
          "eslint"
        ],
        "format": [
          "prettier"
        ]
      },
      "sh": {
        "server": [
          "bashls"
        ],
        "format": [
          "shfmt"
        ]
      },
      "dockerfile": {
        "server": [
          "dockerls"
        ]
      }
    },
    "macro": {
      "escapeCharacters": [
        "\"",
        "'"
      ],
      "saved":{}
      }
    }
  }
